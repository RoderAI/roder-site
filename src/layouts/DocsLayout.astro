---
import Layout from "./Layout.astro";
import { docsOgImageForPath } from "../lib/seo";

export interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
  prev?: { href: string; title: string };
  next?: { href: string; title: string };
}

const { title, eyebrow, description, prev, next } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonicalPath = Astro.url.pathname;

const sections = [
  {
    label: "Getting started",
    items: [
      { href: "/docs/", title: "Overview" },
      { href: "/docs/install/", title: "Install & run" },
      { href: "/changelog/", title: "CLI changelog" },
      { href: "/docs/use-cases/", title: "Use cases" },
      { href: "/docs/evals/", title: "Eval harness" },
    ],
  },
  {
    label: "Desktop & workspaces",
    items: [
      { href: "/docs/desktop/", title: "Desktop guide" },
      { href: "/docs/persistent-agents/", title: "Persistent agents & issues" },
      { href: "/docs/cloud-machines/", title: "Cloud Machines" },
      { href: "/docs/tui/", title: "Terminal interface" },
    ],
  },
  {
    label: "Models & providers",
    items: [
      { href: "/docs/providers/", title: "Inference providers" },
      { href: "/docs/claude-code/", title: "Claude Code provider" },
      { href: "/docs/openrouter/", title: "OpenRouter" },
      { href: "/docs/roder-cloud/", title: "roder.cloud provider" },
      { href: "/docs/fireworks/", title: "Fireworks provider" },
      { href: "/docs/vertex/", title: "Google Vertex AI" },
      { href: "/docs/tool-search/", title: "Provider tool search" },
    ],
  },
  {
    label: "Agents & automation",
    items: [
      { href: "/docs/agent-control/", title: "Agent control" },
      { href: "/docs/agent-swarm/", title: "Agent swarm" },
      { href: "/docs/ultra-mode/", title: "Ultra mode" },
      { href: "/docs/goal-mode/", title: "Plan mode & goals" },
      { href: "/docs/thread-followups/", title: "Thread follow-ups" },
      { href: "/docs/workflows/", title: "Dynamic workflows" },
      { href: "/docs/roadmap-loop/", title: "Roadmap orchestration" },
      { href: "/docs/local-hooks/", title: "Local hooks" },
      { href: "/docs/code-review/", title: "Code review" },
    ],
  },
  {
    label: "Browser & media",
    items: [
      { href: "/docs/browser-decisions/", title: "Browser decisions" },
      { href: "/docs/chrome/", title: "Chrome browser control" },
      { href: "/docs/media-generation/", title: "Media generation" },
      { href: "/docs/speech/", title: "Speech" },
    ],
  },
  {
    label: "Tools & remote execution",
    items: [
      { href: "/docs/tools/", title: "Tools & policy" },
      { href: "/docs/codex-parity-tools/", title: "Codex-parity tools" },
      { href: "/docs/edit-tools/", title: "Edit tools package" },
      { href: "/docs/zerolang/", title: "Zerolang graph edits" },
      { href: "/docs/blaxel-runner/", title: "Blaxel sandbox runner" },
      { href: "/docs/remote-nodes/", title: "Remote agent nodes" },
      { href: "/docs/hosted-service/", title: "Hosted service" },
    ],
  },
  {
    label: "State & observability",
    items: [
      { href: "/docs/event-bus/", title: "Events & replay" },
      { href: "/docs/sessions/", title: "Sessions & state" },
      { href: "/docs/lifecycle-recovery/", title: "Lifecycle recovery" },
      { href: "/docs/workspace-forks/", title: "Workspace forks" },
      { href: "/docs/memories/", title: "Memory & embeddings" },
      { href: "/docs/knowledge/", title: "Project knowledge" },
      { href: "/docs/usage-analytics/", title: "Usage analytics" },
    ],
  },
  {
    label: "Build on Roder",
    items: [
      { href: "/docs/architecture/", title: "Runtime architecture" },
      { href: "/docs/extensibility/", title: "Extension model" },
      { href: "/docs/sdk/", title: "TypeScript SDK" },
      { href: "/extensions/", title: "Extension directory" },
      { href: "/docs/mcp/", title: "MCP integration" },
      { href: "/docs/process-extensions/", title: "Process extensions" },
      { href: "/docs/cursor-sdk-agents/", title: "Cursor SDK agents" },
    ],
  },
  {
    label: "Protocols",
    items: [
      { href: "/docs/app-server/", title: "App server" },
      { href: "/docs/acp/", title: "ACP compatibility" },
    ],
  },
];
---

<Layout
  title={`${title} · Roder`}
  description={description}
  canonicalPath={canonicalPath}
  image={docsOgImageForPath(canonicalPath)}
>
  <div class="container">
    <div class="docs-shell">
      <aside class="sidebar">
        <details class="docs-navigation" open>
          <summary>Browse docs</summary>
          <nav aria-label="Documentation">
        {sections.map((section) => (
          <>
            <h4>{section.label}</h4>
            <ul>
              {section.items.map((item) => {
                const itemPath = item.href.replace(/\/$/, "") || "/";
                const active = itemPath === path;
                return (
                  <li>
                    <a href={item.href} class={active ? "active" : ""}>{item.title}</a>
                  </li>
                );
              })}
            </ul>
          </>
        ))}
          </nav>
        </details>
      </aside>
      <article class="doc-content">
        {eyebrow && <div class="eyebrow">{eyebrow}</div>}
        <h1>{title}</h1>
        <slot />
        {(prev || next) && (
          <nav class="next-prev">
            {prev ? (
              <a href={prev.href}>
                <span class="label">Previous</span>
                <span class="title">{prev.title}</span>
              </a>
            ) : <span />}
            {next ? (
              <a href={next.href} class="next">
                <span class="label">Next</span>
                <span class="title">{next.title}</span>
              </a>
            ) : <span />}
          </nav>
        )}
      </article>
    </div>
  </div>
</Layout>

<script>
  const navigation = document.querySelector(".docs-navigation");
  const mobile = window.matchMedia("(max-width: 850px)");
  const updateNavigation = () => {
    if (navigation instanceof HTMLDetailsElement) {
      navigation.open = !mobile.matches;
    }
  };
  updateNavigation();
  mobile.addEventListener("change", updateNavigation);
</script>
