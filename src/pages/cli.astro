---
import Layout from "../layouts/Layout.astro";
import "../styles/roder-cli.css";
import "../styles/cli-product.css";

const installCommands = [
  {
    title: "Quick install",
    note: "Linux and Apple Silicon macOS",
    command: "curl -fsSL https://github.com/RoderAI/roder/releases/download/latest/install.sh | bash",
  },
  {
    title: "Install with Homebrew",
    note: "Roder Homebrew tap",
    command: "brew install RoderAI/tap/roder",
  },
  {
    title: "Install with npm",
    note: "Native CLI distributed through npm",
    command: "npm install -g @roderai/roder",
  },
  {
    title: "Build from source",
    note: "For local development",
    command: "git clone https://github.com/RoderAI/roder.git\ncd roder\nmake install",
  },
];

const featureCards = [
  {
    title: "Choose the model for the task",
    body: "Use built-in providers or a custom compatible endpoint. Switch models within a thread while Roder keeps the workspace, tool history and policy state.",
    href: "/docs/providers/",
    link: "Providers and model setup",
  },
  {
    title: "Resume or explore another path",
    body: "Reopen saved work with its transcript and settings. Use /fork for a child conversation in a separate workspace, retaining the original thread. The default Git provider requires a clean, committed checkout.",
    href: "/docs/sessions/",
    link: "How thread state is saved",
  },
  {
    title: "Delegate a part of the job",
    body: "Give teammates scoped work, send follow-ups and inspect their results. Coding agents can use shared files or owned worktrees from a clean, committed checkout; nothing merges automatically.",
    href: "/docs/agent-control/",
    link: "Agents and worktree ownership",
  },
  {
    title: "Choose when tools can act",
    body: "Use plan mode to inspect and propose changes, then choose an approval policy for execution. Tool calls and delegated work pass through runtime policy rather than a separate TUI-only gate.",
    href: "/docs/tools/",
    link: "Tools and approval policy",
  },
  {
    title: "Review the patch separately",
    body: "Run /review against local changes, a commit or a base branch. A read-only reviewer returns file- and line-linked findings; applying fixes or publishing a review stays a separate action.",
    href: "/docs/code-review/",
    link: "Read-only review workflow",
  },
  {
    title: "Keep prompts and source intact",
    body: "Compose multiline instructions, recover rejected input with /retry, and use /copy for original Markdown or code without terminal wrapping. Uncertain submissions are not automatically resent.",
    href: "/docs/tui/",
    link: "Terminal controls and recovery",
  },
];

const toolCards = [
  {
    title: "Bring the project's workflow",
    body: "Connect MCP tools and skills, and use project-local hooks around prompts, tool calls, approvals and sessions. Enable /ultra when you want proactive delegation on the current thread.",
    href: "/docs/workflows/",
    link: "Tools, skills and workflows",
  },
  {
    title: "Check work in the browser",
    body: "Use Jev or OpenAI Decisions for browser tasks with page evidence, saved download results and explicit success conditions. Request-aware waits and shared form-value generation reduce repeated work; verify the observed outcome.",
    href: "/docs/browser-decisions/",
    link: "Browser work and verification",
  },
  {
    title: "Create and inspect images",
    body: "Generate or revise images as shared artifacts, and preview them inline in supported Kitty/Sixel terminals. Other terminals show paths and metadata. OpenAI image generation has separate API billing.",
    href: "/docs/media-generation/",
    link: "Media tools and providers",
  },
];

const workflowSteps = [
  {
    title: "Understand the change",
    body: "Start in your repo. Ask Roder to inspect the relevant files, explain a failure or propose a plan using the project's instructions and tools.",
  },
  {
    title: "Work with a visible trail",
    body: "Follow streamed responses, tool activity and file diffs. Steer the next step, answer an approval request or delegate an independent task.",
  },
  {
    title: "Verify and carry it forward",
    body: "Ask for tests and a review of the patch. Inspect the evidence, then continue in the saved thread or fork a different approach.",
  },
];

const screenshots = [
  {
    image: "/product/roder-cli/ghostty-roder-demo.png",
    title: "Real build demo",
    body: "Captured from Ghostty after a Roder run in `~/tmp/roder-cli-product-demo` created `index.html` and `styles.css`.",
  },
  {
    image: "/product/roder-cli/ghostty-resume.png",
    title: "Resume saved work",
    body: "The same thread reopens with the saved transcript, model, workspace, and input box ready for the next instruction.",
  },
  {
    image: "/product/roder-cli/ghostty-providers.png",
    title: "Provider and exec surfaces",
    body: "Auth status, media providers, and `roder exec --help` are plain CLI surfaces for scripting and setup checks.",
  },
  {
    image: "/product/roder-cli/ghostty-app-server.png",
    title: "Control plane",
    body: "`roder app-server --listen stdio://` exposes the same runtime to trusted local clients and protocol adapters.",
  },
];

const providers = [
  "OpenAI",
  "Codex",
  "Anthropic",
  "Gemini",
  "Vertex AI",
  "xAI",
  "OpenRouter",
  "Fireworks AI",
  "DeepSeek",
  "Cursor",
  "Claude Code",
  "Kimi Code",
  "Roder Cloud",
];
---

<Layout
  title="Roder CLI - the agent harness in your terminal"
  description="Code, test and review from your terminal with Roder's open-source Rust harness: saved threads, model choice, delegated agents, worktrees and explicit tool policy."
  canonicalPath="/cli/"
>
  <div class="cli-page">
    <section class="cli-hero">
      <div class="cli-container cli-hero-grid">
        <div class="cli-hero-copy">
          <span class="cli-kicker">Roder CLI / Open-source agent harness</span>
          <h1>Build in your repo. Stay in your terminal.</h1>
          <p>
            The terminal client for Roder's open-source Rust harness. Ask it to
            investigate, change code, run tests and review the diff, with a saved
            thread you can resume or fork.
          </p>
          <div class="cli-actions" aria-label="Primary actions">
            <a class="cli-button cli-button-primary" href="#install">Install the CLI</a>
            <a class="cli-button cli-button-secondary" href="#workflow">See the workflow</a>
          </div>
          <ul class="cli-hero-points" aria-label="Roder CLI highlights">
            <li>Model choice with shared tools and thread state</li>
            <li>Read-only review and owned agent worktrees</li>
            <li>Interactive TUI, headless runs and ACP</li>
          </ul>
          <p class="cli-product-links">
            Prefer a visual workspace? <a href="/desktop/">Explore Desktop</a>.
            Building a client? <a href="/harness/">Explore the harness</a>.
          </p>
        </div>
        <figure class="cli-hero-shot">
          <img
            src="/product/roder-cli/ghostty-roder-demo.png"
            alt="Ghostty terminal showing Roder building a small Patchboard static site in a temporary repo"
            width="1920"
            height="1280"
          />
          <figcaption>
            Real demo captured in Ghostty from `~/tmp/roder-cli-product-demo`.
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="cli-section" id="workflow">
      <div class="cli-container">
        <div class="cli-section-head">
          <h2>From a question to a checked change.</h2>
          <p>
            Keep the investigation, edits, commands and review in one thread.
            Roder runs against your workspace, so you can inspect what happened
            and decide what comes next.
          </p>
        </div>
        <ol class="cli-workflow-map">
          {workflowSteps.map((step, index) => (
            <li>
              <span class="cli-step-number" aria-hidden="true">0{index + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="cli-section" id="features">
      <div class="cli-container">
        <div class="cli-section-head">
          <h2>A workflow that survives the next turn.</h2>
          <p>
            The harness manages more than the model request: thread state,
            tool execution, policy and agent lifecycles. The terminal makes
            those controls available while you work.
          </p>
        </div>
        <div class="feature-grid cli-product-grid">
          {featureCards.map((feature) => (
            <article class="feature-card">
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
              <a class="cli-text-link" href={feature.href}>{feature.link}</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="cli-section screenshots-section" aria-labelledby="cli-screenshots-heading">
      <div class="cli-container">
        <div class="cli-section-head">
          <h2 id="cli-screenshots-heading">The terminal, as it runs.</h2>
          <p>
            Real Ghostty captures: a small static-site build, its saved thread,
            provider setup and the local app-server. These show the CLI itself,
            not a simulated conversation.
          </p>
        </div>
        <div class="screenshot-grid">
          {screenshots.map((shot) => (
            <figure class="screenshot-card">
              <img src={shot.image} alt={`${shot.title} screenshot`} loading="lazy" />
              <figcaption>
                <strong>{shot.title}</strong>
                <span>{shot.body}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="cli-section provider-section">
      <div class="cli-container provider-layout">
        <div>
          <h2>Choose the provider. Keep the workflow.</h2>
          <p>
            Roder separates provider integration from the tools, saved threads
            and approval policy you use to get work done. Use built-in integrations
            or configure a compatible endpoint. Model capabilities and provider
            billing still apply.
          </p>
          <div class="provider-list" aria-label="Supported provider examples">
            {providers.map((provider) => <span>{provider}</span>)}
          </div>
          <a class="cli-text-link" href="/docs/providers/">Compare provider setup and capabilities</a>
        </div>
        <div class="config-panel">
          <h3>Custom provider example</h3>
          <pre><code>{`provider = "synthetic"
model = "syn:large:text"

[providers.synthetic]
api_key_env = "SYNTHETIC_API_KEY"
base_url = "https://api.synthetic.new/openai/v1"`}</code></pre>
        </div>
      </div>
    </section>

    <section class="cli-section">
      <div class="cli-container">
        <div class="cli-section-head">
          <h2>Work beyond the source file.</h2>
          <p>
            Bring in project-specific tools, check a browser flow or create
            media without moving the task into an unrelated chat.
          </p>
        </div>
        <div class="feature-grid cli-product-grid">
          {toolCards.map((feature) => (
            <article class="feature-card">
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
              <a class="cli-text-link" href={feature.href}>{feature.link}</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="cli-section workflow-section">
      <div class="cli-container workflow-grid">
        <div class="workflow-copy">
          <h2>Use the harness without the terminal UI.</h2>
          <p>
            Run <code>roder exec</code> for scripts, evals and one-shot automation.
            Use <code>roder acp</code> from a compatible editor or host, or start
            the JSON-RPC app-server for a custom client. These are entry points
            to the runtime, not separate agent implementations.
          </p>
          <p>
            ACP exposes the capabilities supported by that adapter; native
            clients use the broader app-server protocol.
          </p>
          <div class="cli-integration-links">
            <a href="/docs/acp/">ACP setup</a>
            <a href="/docs/app-server/">App-server protocol</a>
            <a href="/harness/">Harness architecture</a>
          </div>
        </div>
        <div class="workflow-commands">
          <pre><code>{`roder
roder resume <thread-id>
roder exec "inspect this repo"
roder exec resume --last "continue"
roder acp
roder app-server --listen stdio://
roder media providers`}</code></pre>
        </div>
      </div>
    </section>

    <section class="cli-install" id="install">
      <div class="cli-container">
        <div class="cli-section-head">
          <h2>Start with the CLI.</h2>
          <p>
            Choose npm, Homebrew, the release installer or a source build.
            The quick-install script verifies the release archive's SHA-256
            checksum and writes <code>roder</code> to <code>~/.local/bin</code>
            unless you override the destination.
          </p>
        </div>
        <div class="install-layout">
          <div class="install-commands">
            {installCommands.map((item) => (
              <article class="install-command">
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.note}</p>
                </div>
                <pre><code>{item.command}</code></pre>
              </article>
            ))}
          </div>
          <aside class="install-card" aria-label="First run with Codex">
            <h3>First run with Codex</h3>
            <ol>
              <li><code>export PATH="$HOME/.local/bin:$PATH"</code></li>
              <li><code>roder auth login codex</code></li>
              <li><code>roder auth status</code></li>
              <li><code>cd /path/to/your/repo</code></li>
              <li><code>roder</code></li>
            </ol>
            <p>
              Using another provider? <a href="/docs/providers/">Choose its authentication setup</a>.
              See <a href="/docs/install/">installation details</a> for supported platforms.
              Use <code>--config-dir /tmp/lab-roder</code> for a separate config
              and thread store.
            </p>
          </aside>
        </div>
      </div>
    </section>

    <section class="cli-section cli-surface-section">
      <div class="cli-container">
        <div class="cli-section-head">
          <h2>One harness. Choose how you work.</h2>
          <p>
            The CLI is for terminal sessions and automation. Desktop adds a
            visual workspace around Roder, while the open harness lets you
            build your own client or distribution.
          </p>
        </div>
        <div class="feature-grid cli-product-grid">
          <article class="feature-card">
            <h3>CLI</h3>
            <p>Stay close to your editor, shell and repo. Work interactively or run a task from a script.</p>
            <a class="cli-text-link" href="/docs/tui/">Learn the terminal controls</a>
          </article>
          <article class="feature-card">
            <h3>Desktop</h3>
            <p>Manage projects and threads in a visual workspace with file, diff, terminal and browser panels.</p>
            <a class="cli-text-link" href="/desktop/">Explore Roder Desktop</a>
          </article>
          <article class="feature-card">
            <h3>Harness</h3>
            <p>Build on the Rust runtime, extensions and client protocols that power Roder's product surfaces.</p>
            <a class="cli-text-link" href="/harness/">Explore the open harness</a>
          </article>
        </div>
      </div>
    </section>

    <section class="cli-final">
      <div class="cli-container cli-final-inner">
        <div>
          <h2>Give your next change a thread.</h2>
          <p>
            Install Roder, choose a provider and open it in your repo.
            Start with a question, a bug or a patch you want reviewed.
          </p>
        </div>
        <a class="cli-button cli-button-primary" href="#install">Install the CLI</a>
      </div>
    </section>
  </div>
</Layout>
