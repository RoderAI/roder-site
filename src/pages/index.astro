---
import Layout from "../layouts/Layout.astro";
import HarnessStack from "../components/HarnessStack.astro";
import "../styles/product.css";
import "../styles/home-product.css";

const workflows = [
  {
    number: "01",
    title: "Work across models",
    body: "Choose a provider for the task. Keep tools, approvals, and saved work in the same harness.",
    href: "/docs/providers/",
    link: "Model and provider choices",
  },
  {
    number: "02",
    title: "Delegate without losing the thread",
    body: "Split independent work among agents, inspect their progress, and bring results back to the parent conversation.",
    href: "/docs/agent-control/",
    link: "Agents and worktree isolation",
  },
  {
    number: "03",
    title: "Keep the project context",
    body: "Resume saved threads. Give a persistent agent a mission and memory, then explicitly enable bounded work in Desktop.",
    href: "/docs/persistent-agents/",
    link: "Persistent agents and local issues",
  },
  {
    number: "04",
    title: "Check more than the code",
    body: "Inspect files, run commands, review changes, and check browser evidence beside the conversation.",
    href: "/docs/desktop/",
    link: "The Desktop workspace",
  },
];

const choices = [
  {
    title: "Your model is a choice.",
    body: "Roder connects to multiple inference providers. Authentication and supported capabilities are documented for each provider.",
    href: "/docs/providers/",
  },
  {
    title: "The runtime is open to change.",
    body: "Providers, tools, storage, memory, and runners plug into the harness. Build a different product surface without rewriting the turn loop.",
    href: "/docs/extensibility/",
  },
  {
    title: "Agent work leaves a record.",
    body: "Saved threads and typed events expose tool activity, approvals, and outcomes for inspection, recovery, and evaluation.",
    href: "/docs/event-bus/",
  },
  {
    title: "The app uses the same foundation.",
    body: "Desktop, the terminal client, and app-server integrations build on the Rust harness. Desktop adds native workspace panels and project workflows.",
    href: "/harness/",
  },
];
---

<Layout
  title="Roder · the open coding-agent harness and desktop"
  description="An open Rust harness for coding agents, with a desktop workspace for models, subagents, browser work, and code review. Use Roder or build on it."
  canonicalPath="/"
>
  <div class="product-page product-home">
    <section class="product-container product-hero home-intro">
      <div class="home-intro-copy">
        <p class="product-kicker"><span class="product-status-dot"></span> Open-source harness / native desktop</p>
        <h1>The open harness<br />for coding agents<span class="product-accent">.</span></h1>
        <p class="product-lead">
          Run it in a desktop built for real work. Or build your own agent on the
          same Rust runtime.
        </p>
        <p class="home-intro-detail">
          Roder brings model choice, tools, agent coordination, and durable state
          into one harness. Desktop puts that power beside your files, terminal,
          browser, and changes.
        </p>
        <div class="product-actions">
          <a class="product-button product-button-primary" href="/desktop/">Explore Desktop <span aria-hidden="true">↗</span></a>
          <a class="product-button" href="/harness/">Meet the harness <span aria-hidden="true">→</span></a>
        </div>
        <div class="home-intro-foot">
          <a href="/cli/">Prefer the terminal? Install the CLI <span aria-hidden="true">→</span></a>
          <span>Alpha software. macOS &amp; Windows desktop builds.</span>
        </div>
      </div>
      <div class="home-intro-note" aria-label="Roder product structure">
        <img src="/roder-icon.png" width="64" height="64" alt="" />
        <span>One foundation.</span>
        <strong>Your choice of interface.</strong>
        <a href="/desktop/">Desktop</a>
        <a href="/cli/">Terminal</a>
        <a href="/harness/#build">Your product</a>
      </div>
    </section>

    <section class="product-container home-desktop" aria-labelledby="desktop-preview-heading">
      <div class="home-desktop-topline">
        <div>
          <p class="product-kicker">Roder Desktop</p>
          <h2 id="desktop-preview-heading">A workspace for the whole task.</h2>
        </div>
        <a class="product-text-link" href="/desktop/">See what Desktop can do <span aria-hidden="true">↗</span></a>
      </div>
      <figure class="home-app-frame">
        <div class="home-app-label" aria-hidden="true">
          <span><i></i><i></i><i></i></span>
          <span>Roder Desktop · project workspace</span>
          <span>Actual app</span>
        </div>
        <img
          src="https://dl.roder.sh/desktop/product/desktop-subagents-panel.png"
          width="2880"
          height="1880"
          alt="Roder Desktop with the conversation, tool activity, and Subagents panel open in one project workspace."
          fetchpriority="high"
        />
        <figcaption>
          Follow the work from the conversation to the agents doing it. Open
          review, files, terminal, and browser panels as the task needs them.
        </figcaption>
      </figure>
      <div class="home-workflows">
        {workflows.map((workflow) => (
          <article>
            <span class="product-index">{workflow.number}</span>
            <div>
              <h3>{workflow.title}</h3>
              <p>{workflow.body}</p>
              <a class="product-text-link" href={workflow.href}>{workflow.link} <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="home-harness-band" aria-labelledby="harness-heading">
      <div class="product-container home-harness-grid">
        <div>
          <p class="product-kicker">Under the app</p>
          <h2 id="harness-heading">The harness does the runtime work.</h2>
          <p class="product-lead">A model proposes the next step. Roder manages the turn around it.</p>
          <p>
            The Rust core coordinates context, inference, tool execution, policy,
            cancellation, and state. Extensions supply the provider and workspace
            capabilities. Clients use the app-server control plane.
          </p>
          <a class="product-button product-button-light" href="/harness/">Explore the harness <span aria-hidden="true">→</span></a>
        </div>
        <HarnessStack />
      </div>
    </section>

    <section class="product-container product-section home-differences" aria-labelledby="differences-heading">
      <div class="product-section-heading">
        <p class="product-kicker">Why Roder</p>
        <h2 id="differences-heading">A coding tool you can<br />build on.</h2>
        <p>
          If you are comparing coding tools, these are the choices Roder makes:
          an open runtime, multiple providers, and a workspace that exposes the work.
        </p>
      </div>
      <div class="home-choice-list">
        {choices.map((choice) => (
          <a href={choice.href}>
            <h3>{choice.title}</h3>
            <p>{choice.body}</p>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
      <p class="product-fineprint">
        Local threads do not mean offline inference. Requests go to the configured
        provider; browser and cloud tools use the services you connect. Provider
        capabilities and costs vary. Roder is actively developed alpha software.
      </p>
    </section>

    <section class="home-start-band">
      <div class="product-container product-section">
        <div class="product-section-heading">
          <p class="product-kicker">Start with your workflow</p>
          <h2>Use Roder. Or build on it.</h2>
        </div>
        <div class="home-entry-grid">
          <article>
            <span class="product-index">For your projects</span>
            <h3>Roder Desktop</h3>
            <p>
              Open a repository, choose a model, and keep agent work, files, review,
              and browser checks in one place.
            </p>
            <a class="product-button product-button-primary" href="/desktop/">Get Desktop <span aria-hidden="true">↗</span></a>
            <a class="product-text-link" href="/cli/">Or work in the terminal <span aria-hidden="true">→</span></a>
          </article>
          <article>
            <span class="product-index">For your product</span>
            <h3>The Roder harness</h3>
            <p>
              Bring your interface, providers, or domain tools. Reuse the turn
              engine and connect through the app server, SDK, or extension API.
            </p>
            <a class="product-button" href="/harness/#build">Build on Roder <span aria-hidden="true">→</span></a>
            <a class="product-text-link" href="https://github.com/RoderAI/roder" rel="noopener noreferrer">Read the source <span aria-hidden="true">↗</span></a>
          </article>
        </div>
        <div class="home-resource-links">
          <a href="/changelog/">Recent releases</a>
          <a href="/evals/">Evaluation results</a>
          <a href="/mission/">Design principles</a>
          <a href="/contact/">Talk to the team</a>
        </div>
      </div>
    </section>
  </div>
</Layout>
