---
import Layout from "../layouts/Layout.astro";
import DesktopWorkflows from "../components/DesktopWorkflows.astro";
import "../styles/roder-desktop.css";
import "../styles/desktop-product.css";
import {
  DESKTOP_APPCAST_URL,
  DESKTOP_CHECKSUMS_URL,
  DESKTOP_MACOS_DMG_URL,
  DESKTOP_MACOS_ZIP_URL,
  DESKTOP_RELEASES_URL,
  DESKTOP_UPDATES_JSON_URL,
  DESKTOP_WINDOWS_EXE_URL,
  assetUrl,
  fetchLatestDesktopRelease,
  githubFallbackUrl,
  primaryDownloadForPlatform,
} from "../lib/desktop-downloads";

const release = await fetchLatestDesktopRelease();
const versionLabel = release ? release.tagName : "latest";
const downloadSource = release?.source === "r2" ? "dl.roder.sh" : "GitHub Releases";
const macosDmgUrl = assetUrl(
  release,
  "Roder-macos-arm64.dmg",
  release ? githubFallbackUrl("Roder-macos-arm64.dmg") : DESKTOP_MACOS_DMG_URL,
);
const macosZipUrl = assetUrl(
  release,
  "Roder-macos-arm64.zip",
  release ? githubFallbackUrl("Roder-macos-arm64.zip") : DESKTOP_MACOS_ZIP_URL,
);
const windowsExeUrl = assetUrl(
  release,
  "Roder-windows-x64-installer.exe",
  release ? githubFallbackUrl("Roder-windows-x64-installer.exe") : DESKTOP_WINDOWS_EXE_URL,
);
const checksumsUrl = assetUrl(
  release,
  "SHA256SUMS",
  release ? githubFallbackUrl("SHA256SUMS") : DESKTOP_CHECKSUMS_URL,
);
const releasesUrl = DESKTOP_RELEASES_URL;
const defaultPrimary = {
  ...primaryDownloadForPlatform("mac"),
  href: macosDmgUrl,
};

const platformDownloads = [
  {
    id: "mac",
    title: "macOS (Apple silicon)",
    note: "Signed and notarized DMG. Drag Roder into Applications, then launch.",
    href: macosDmgUrl,
    fileName: "Roder-macos-arm64.dmg",
    cta: "Download DMG",
  },
  {
    id: "windows",
    title: "Windows (x64)",
    note: "One-click Squirrel installer. Run the .exe and follow the prompts.",
    href: windowsExeUrl,
    fileName: "Roder-windows-x64-installer.exe",
    cta: "Download installer",
  },
];

const productImageBase = "https://dl.roder.sh/desktop/product";
const providers = [
  "Codex",
  "Cursor",
  "SuperGrok",
  "OpenRouter",
  "Fireworks",
  "Gemini",
  "OpenAI",
  "Claude Code",
  "Kimi Code",
  "Anthropic",
  "xAI",
  "DeepSeek",
  "Composer",
  "Vertex AI",
  "Roder Cloud",
];
---

<Layout
  title="Roder Desktop - a workspace for coding agents"
  description="Run the Roder harness in a local desktop workspace. Choose providers, follow delegated work, inspect code and browser evidence, and give recurring work a persistent agent."
  canonicalPath="/desktop/"
>
  <div class="desktop-page desktop-product">
    <section class="desktop-hero">
      <div class="desktop-container desktop-hero-grid">
        <div class="desktop-hero-copy">
          <p class="desktop-product-eyebrow">Roder Desktop / your local agent workspace</p>
          <h1>A workspace<br />for <span>coding agents.</span></h1>
          <p>
            Give coding agents a project, then stay close to what they do.
            Follow delegated work, inspect changed files, and check the result
            in a terminal or browser beside the conversation.
          </p>
          <div class="desktop-actions" aria-label="Primary actions">
            <a
              class="desktop-button desktop-button-primary"
              id="desktop-primary-download"
              data-mac-href={macosDmgUrl}
              data-mac-label="Download for Mac"
              data-windows-href={windowsExeUrl}
              data-windows-label="Download for Windows"
              href={defaultPrimary.href}
              rel="noopener noreferrer"
            >
              {defaultPrimary.label}
            </a>
            <a class="desktop-button desktop-button-secondary" href="#install">
              Platforms &amp; install
            </a>
            <a
              class="desktop-button desktop-button-secondary"
              href="/docs/desktop/"
            >
              Explore the guide
            </a>
          </div>
          <p
            class="desktop-download-meta"
            id="desktop-download-meta"
            data-version={versionLabel}
          >
            Latest {versionLabel} · macOS DMG or Windows installer · one click
          </p>
          <ul class="desktop-hero-points" aria-label="Roder Desktop highlights">
            <li>Choose your inference provider and model</li>
            <li>Keep project threads and history on your machine</li>
            <li>Built on the same Rust harness as the CLI</li>
          </ul>
        </div>
        <figure class="desktop-hero-shot">
          <img
            src={`${productImageBase}/desktop-new-agent.png`}
            alt="Roder Desktop start screen with project-grouped threads, Start a new agent pane, and a high-reasoning model selection"
            width="2880"
            height="1880"
          />
          <figcaption>
            A real Roder Desktop workspace: projects, saved threads, and the agent composer.
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="desktop-product-foundation" aria-labelledby="desktop-foundation-heading">
      <div class="desktop-container desktop-product-foundation-grid">
        <div>
          <p class="desktop-product-eyebrow">One harness. A desktop built around it.</p>
          <h2 id="desktop-foundation-heading">A workspace for the whole agent loop.</h2>
        </div>
        <div>
          <p>
            The Roder harness handles models, tools, sessions, and approval policy.
            Desktop brings that runtime into a project workspace with native
            terminals, browser views, files, and review panels.
          </p>
          <p>
            Use the <a href="/cli/">CLI</a> when you want a terminal.
            Use Desktop when you want the conversation and the work side by side.
            Both build on Roder; Desktop ships its own versioned harness.
          </p>
          <a class="desktop-product-link" href="/harness/">Meet the harness behind Desktop <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
    </section>

    <DesktopWorkflows />

    <section class="desktop-section desktop-product-providers" aria-labelledby="desktop-providers-heading">
      <div class="desktop-container">
        <div class="desktop-product-provider-grid">
          <div>
            <p class="desktop-product-eyebrow">Provider choice, without changing your workspace</p>
            <h2 id="desktop-providers-heading">Choose the model.<br />Keep the project.</h2>
            <p>
              Connect your accounts in Settings. Choose from the model catalog
              exposed by the harness, with reasoning controls where supported.
              Your files, tools, and project threads stay in the same workspace.
            </p>
            <ul class="desktop-provider-list" aria-label="Supported provider integrations">
              {providers.map((name) => <li>{name}</li>)}
            </ul>
            <p class="desktop-product-note">
              Authentication and available models vary by provider. Inference
              accounts and charges are separate; a local workspace does not mean
              the model runs locally.
            </p>
            <a class="desktop-product-link" href="/docs/providers/">Find your provider <span aria-hidden="true">&rarr;</span></a>
          </div>
          <figure class="desktop-screenshot-card">
            <img
              src={`${productImageBase}/desktop-model-picker.png`}
              alt="The searchable provider and model picker in Roder Desktop"
              width="1440"
              height="940"
              loading="lazy"
            />
            <figcaption>Real product capture. Browse models by provider; setup entries help you connect an account.</figcaption>
          </figure>
        </div>
        <div class="desktop-product-extension-row">
          <h3>Bring the tools your project needs.</h3>
          <p>
            Complete <code>$</code> skills and target <code>@</code> MCP servers
            from the composer. Add files, sketches, or voice input, and choose
            plan mode before work begins.
          </p>
          <a class="desktop-product-link" href="/docs/workflows/">Skills, MCP &amp; workflows <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
    </section>

    <section class="desktop-install" id="install">
      <div class="desktop-container">
        <div class="desktop-section-head">
          <p class="desktop-product-eyebrow">Start with a project</p>
          <h2>Install. Connect a provider. Open a repo.</h2>
          <p>
            Pick your platform. macOS builds are signed and notarized; Windows ships a
            Squirrel x64 installer. Roder Desktop is alpha software.
            Official builds currently target macOS Apple silicon and Windows x64.
          </p>
        </div>
        <div class="desktop-download-grid" role="list">
          {
            platformDownloads.map((item) => (
              <article class="desktop-download-card" data-platform={item.id} role="listitem">
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.note}</p>
                  <p class="desktop-download-file">{item.fileName}</p>
                </div>
                <a
                  class="desktop-button desktop-button-primary"
                  href={item.href}
                  rel="noopener noreferrer"
                >
                  {item.cta}
                </a>
              </article>
            ))
          }
        </div>
        <p class="desktop-product-release-links">
          <a href={releasesUrl} rel="noopener noreferrer">All releases</a>
          <span aria-hidden="true">/</span>
          <a href="/docs/desktop/">First-run guide</a>
          <span aria-hidden="true">/</span>
          <a href="/docs/cloud-machines/">Cloud Machines platform limits</a>
        </p>
        <details class="desktop-product-download-details">
          <summary>Alternative downloads, verification &amp; update feeds</summary>
          <div class="desktop-install-layout desktop-install-secondary">
            <div class="desktop-install-commands">
              <article class="desktop-install-command">
                <div>
                  <h3>
                    <a href={macosZipUrl} rel="noopener noreferrer">macOS zip + checksums</a>
                  </h3>
                  <p>Same Apple silicon build as a zip, plus SHA256SUMS for verification.</p>
                </div>
                <pre><code>{`${macosZipUrl}\n${checksumsUrl}`}</code></pre>
              </article>
              <article class="desktop-install-command">
                <div>
                  <h3>
                    <a href={DESKTOP_APPCAST_URL} rel="noopener noreferrer">Sparkle feeds (R2)</a>
                  </h3>
                  <p>
                    macOS auto-updates read Cloudflare R2 feeds published by release CI
                    (`updates.json` + Sparkle `appcast.xml` on dl.roder.sh).
                  </p>
                </div>
                <pre><code>{`${DESKTOP_UPDATES_JSON_URL}\n${DESKTOP_APPCAST_URL}`}</code></pre>
              </article>
            </div>
            <aside class="desktop-install-card" aria-label="First run checklist">
              <h3>First run</h3>
              <ol>
                <li>Click Download for your OS</li>
                <li>macOS: drag Roder into Applications</li>
                <li>Windows: run the installer</li>
                <li>Connect an inference provider in Settings</li>
                <li>Open a project and start a new agent</li>
              </ol>
              <p>
                Artifacts from {downloadSource}. On Mac, use{" "}
                <strong>Check for Updates…</strong> — feed{" "}
                <a href={DESKTOP_UPDATES_JSON_URL} rel="noopener noreferrer">updates.json</a>.
              </p>
            </aside>
          </div>
        </details>
      </div>
    </section>

    <section class="desktop-final">
      <div class="desktop-container desktop-final-inner">
        <div>
          <h2>Bring a project.<br />Stay with the work.</h2>
          <p>
            Start a thread, choose a model, and keep the tools you need beside it.
            The <a href="/docs/desktop/">Desktop guide</a> walks through your first project.
          </p>
        </div>
        <a
          class="desktop-button desktop-button-primary"
          id="desktop-final-download"
          data-mac-href={macosDmgUrl}
          data-mac-label="Download for Mac"
          data-windows-href={windowsExeUrl}
          data-windows-label="Download for Windows"
          href={defaultPrimary.href}
          rel="noopener noreferrer"
        >
          {defaultPrimary.label}
        </a>
      </div>
    </section>
  </div>

  <script>
    const detectPlatform = (userAgent: string): "mac" | "windows" | "other" => {
      const ua = userAgent.toLowerCase();
      if (ua.includes("windows") || ua.includes("win32") || ua.includes("win64")) {
        return "windows";
      }
      if (ua.includes("mac os") || ua.includes("macintosh") || ua.includes("mac_powerpc")) {
        return "mac";
      }
      return "other";
    };

    const applyPrimaryDownload = (anchor: HTMLAnchorElement, platform: "mac" | "windows" | "other") => {
      const href =
        platform === "windows"
          ? anchor.dataset.windowsHref
          : anchor.dataset.macHref;
      const label =
        platform === "windows"
          ? anchor.dataset.windowsLabel
          : anchor.dataset.macLabel;
      if (href) anchor.href = href;
      if (label) anchor.textContent = label;
    };

    const platform = detectPlatform(navigator.userAgent);
    document
      .querySelectorAll<HTMLAnchorElement>("#desktop-primary-download, #desktop-final-download")
      .forEach((anchor) => applyPrimaryDownload(anchor, platform));

    const meta = document.getElementById("desktop-download-meta");
    if (meta) {
      const version = meta.dataset.version || "latest";
      if (platform === "windows") {
        meta.textContent = `Latest ${version} · Windows x64 installer · one click`;
      } else if (platform === "mac") {
        meta.textContent = `Latest ${version} · macOS Apple silicon DMG · one click`;
      }
    }

    document.querySelectorAll<HTMLElement>(".desktop-download-card").forEach((card) => {
      card.classList.toggle("is-preferred", card.dataset.platform === platform);
    });
  </script>
</Layout>
